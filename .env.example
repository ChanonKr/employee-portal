# Copy to .env (git-ignored): cp .env.example .env
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=info

# Used when running the API on your machine (make run). docker compose overrides it.
DATABASE_URL=postgres://app:app@localhost:5432/portal?sslmode=disable

# Required. At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=
JWT_TTL=8h

# How many days of change history to keep (1–3650). Older changes are deleted by the
# retention job. How many days employees SEE is an admin setting in the UI (default 7).
HISTORY_RETENTION_DAYS=90
# The retention job connects as the "retention" role (empty disables it). docker compose overrides it.
RETENTION_DATABASE_URL=postgres://retention:retention@localhost:5432/portal?sslmode=disable
RETENTION_INTERVAL=24h

UPLOAD_DIR=/data/uploads
UPLOAD_MAX_BYTES=5242880
CORS_ORIGINS=http://localhost:5173
TRUSTED_PROXIES=
# Sign-in attempts per minute per IP (default 5).
LOGIN_RATE_LIMIT=5
