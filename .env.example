# Copy to .env (git-ignored): cp .env.example .env
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=info

# Used when running the API on your machine (make run). docker compose overrides it.
DATABASE_URL=postgres://app:app@localhost:5432/portal?sslmode=disable

# Required. At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=
JWT_TTL=8h

# Fallback when app_settings.history_days is missing (admins change it in the UI).
HISTORY_DAYS=7

UPLOAD_DIR=/data/uploads
UPLOAD_MAX_BYTES=5242880
CORS_ORIGINS=http://localhost:5173
TRUSTED_PROXIES=
